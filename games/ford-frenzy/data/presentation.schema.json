{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://minoo.live/schemas/ford-frenzy/presentation-v1.schema.json",
  "title": "Ford Frenzy game presentation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "layout",
    "mission",
    "assets",
    "characters",
    "conversations",
    "targetLabels"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "layout": {
      "enum": [
        "conversation"
      ]
    },
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brand",
        "eyebrow",
        "title",
        "totalTargets"
      ],
      "properties": {
        "brand": {
          "type": "string",
          "minLength": 1
        },
        "eyebrow": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "totalTargets": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "url",
          "required"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "url": {
            "type": "string",
            "pattern": "^\\./assets/[A-Za-z0-9][A-Za-z0-9._-]*\\.(png|webp|jpg)$"
          },
          "required": {
            "const": false,
            "description": "Optional portrait presentation only. Required scene textures belong to the renderer manifest."
          }
        }
      }
    },
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "assetId",
          "expressions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "assetId": {
            "type": "string"
          },
          "expressions": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "neutral"
            ],
            "properties": {
              "neutral": {
                "type": "string"
              },
              "annoyed": {
                "type": "string"
              },
              "amused": {
                "type": "string"
              },
              "surprised": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "conversations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "beats",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "beats": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "speaker",
                "line",
                "expression"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "speaker": {
                  "type": "string"
                },
                "line": {
                  "type": "string",
                  "minLength": 1
                },
                "expression": {
                  "enum": [
                    "neutral",
                    "annoyed",
                    "amused",
                    "surprised"
                  ]
                }
              }
            }
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "targetLabels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "objectId",
          "label",
          "inspection"
        ],
        "properties": {
          "objectId": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "inspection": {
            "enum": [
              "brief",
              "inspect"
            ]
          }
        }
      }
    }
  }
}

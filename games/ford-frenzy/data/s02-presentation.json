  "conversations": [
    {
      "id": "s02-opening",
      "beats": [
        {
          "id": "s02-opening-01",
          "speaker": "elliot",
          "line": "City Hall has a public counter and a printer with main character energy. Get the dates straight before Nadia sees a headline.",
          "expression": "neutral"
        },
        {
          "id": "s02-opening-02",
          "speaker": "alex",
          "line": "Bold of you to assume the printer respects my authority.",
          "expression": "annoyed"
        },
        {
          "id": "s02-opening-03",
          "speaker": "elliot",
          "line": "It respects nothing. Bring back May 16 and May 17, in that order, and nothing dated after it.",
          "expression": "amused"
        }
      ],
      "title": "Two dates, one counter"
    },
    {
      "id": "s02-closing",
      "beats": [
        {
          "id": "s02-closing-01",
          "speaker": "alex",
          "line": "Corridor's filed. May 16 report, May 17 denial. That's order, not a verdict.",
          "expression": "neutral"
        },
        {
          "id": "s02-closing-02",
          "speaker": "elliot",
          "line": "Nadia will only mildly threaten us. Progress.",
          "expression": "amused"
        },
        {
          "id": "s02-closing-03",
          "speaker": "alex",
          "line": "Next stop, the deadline desk. Once someone tells me what that means.",
          "expression": "neutral"
        }
      ],
      "title": "Order, not a verdict"
    }
  ]

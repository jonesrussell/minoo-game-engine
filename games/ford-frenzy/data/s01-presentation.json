        {
          "id": "s01-opening-01",
          "speaker": "elliot",
          "line": "Welcome to the Haps. Patio desk is Tuesday. Today you're on the mayor beat.",
          "expression": "neutral"
        },
        {
          "id": "s01-opening-02",
          "speaker": "alex",
          "line": "I don't even have a chair.",
          "expression": "annoyed"
        },
        {
          "id": "s01-opening-03",
          "speaker": "elliot",
          "line": "Classifieds has the chair. You get the folder, the recorder, and whatever coffee still answers to coffee.",
          "expression": "amused"
        }
      ],
      "title": "Your first shift"
    },
    {
      "id": "s01-closing",
      "beats": [
        {
          "id": "s01-closing-01",
          "speaker": "alex",
          "line": "Published report logged. Office rumour stays here. Recorder's alive.",
          "expression": "neutral"
        },
        {
          "id": "s01-closing-02",
          "speaker": "elliot",
          "line": "Careful. Competence makes the furniture nervous.",
          "expression": "amused"
        },
        {
          "id": "s01-closing-03",
          "speaker": "alex",
          "line": "Then point me at City Hall.",

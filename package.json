{
  "name": "minoo-game-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "games/*"
  ],
  "engines": {
    "node": "24.13.1",
    "npm": "11.8.0"
  },
  "packageManager": "npm@11.8.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/unit/*.test.ts",
    "test:e2e": "npm run build && node scripts/test-browser.mjs && node scripts/test-scene-browser.mjs && node scripts/test-replay-browser.mjs",
    "generate:scene-types": "node scripts/generate-scene-types.mjs",
    "check:repository": "node scripts/check-repository.mjs",
    "dev:ford": "node scripts/prepare-ford-assets.mjs && vite --config vite.ford.config.ts",
    "build:ford": "node scripts/prepare-ford-assets.mjs && npm run typecheck && vite build --config vite.ford.config.ts",
    "preview:ford": "vite preview --config vite.ford.config.ts",
    "test:ford": "npm run build:ford && node scripts/test-ford-browser.mjs"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "ajv": "8.20.0",
    "fast-check": "4.9.0",
    "json-schema-to-typescript": "16.0.0",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "zod": "4.5.4"
  }
}
